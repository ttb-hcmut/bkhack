opam-version: "2.0"
synopsis: "BK Hack website"
authors: ["ttb-hcmut"]
maintainer: "Kinten Le <kinten108101@protonmail.com>"
depends: [
  "ocaml" {>= "5.2.0"}
  "reason" {>= "3.13.0"}
  "dune" {>= "3.9"}
  "melange" {>= "4.0.0"}
  "melange-fetch" {>= "0.1.0"}
  "melange-json" {>= "2.0.0"}
  "reason-react" {>= "0.15.0"}
  "reason-react-ppx" {>= "0.15.0"}
  "eio" {>= "1.3"}
  "eio_main" {>= "1.3"}
  "containers" {>= "3.16"}
  "iter" {>= "1.9"}
  "re" {>= "1.14.0"}
  "opam-check-npm-deps" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "dot-merlin-reader" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@react" "@install"]
]
