Standard libraries

```elixir
defmodule RunSql do
  def query(conn, queryList) do
    Enum.map( queryList , fn q -> Exqlite.query!(conn,q) end )
  end
end
```

## Setup

Choose

```elixir
form =
  Kino.Control.form(
    [
      name: Kino.Input.select(
        "Target", [
          {:sqlite,    "Target 1: SQLite"},
          {:supabase,  "Target 2: Supabase"},
          {:firestore, "Target 3: Firestore"},
          {:mongodb,   "Target 4: MongoDB"}
        ])
    ],
    submit: "Submit"
  )

Kino.listen(form, fn event ->
  IO.inspect(event)
  case event.data.name do
    :sqlite -> IO.puts "no"
    :supabase -> IO.puts "ko"
  end
end)

form
