```elixir
opts = [database: "db"]
{:ok, conn} = Kino.start_child({Exqlite, opts})
```

```elixir
defmodule RunSql do
  def query(conn,queryList) do
    Enum.map( queryList , fn q -> Exqlite.query!(conn,q) end )
  end
end
```

<!-- livebook:{"attrs":"eyJjYWNoZV9xdWVyeSI6dHJ1ZSwiY29ubmVjdGlvbiI6eyJ0eXBlIjoic3FsaXRlIiwidmFyaWFibGUiOiJjb25uIn0sInF1ZXJ5IjoiU0VMRUNUICogRlJPTSBzcWxpdGVfbWFzdGVyIFdIRVJFIHR5cGU9J3RhYmxlJyIsInJlc3VsdF92YXJpYWJsZSI6InJlc3VsdCIsInRpbWVvdXQiOm51bGx9","chunks":null,"kind":"Elixir.KinoDB.SQLCell","livebook_object":"smart_cell"} -->

```elixir
result = Exqlite.query!(conn, ~S"SELECT * FROM sqlite_master WHERE type='table'", [])
```

```elixir
dropTablesList = [
  fn -> Exqlite.query!(conn, ~S"drop table if exists pullrequests", []) end,
  fn -> Exqlite.query!(conn, ~S"drop table if exists comments", []) end,
  fn -> Exqlite.query!(conn, ~S"drop table if exists posts", []) end,
  fn -> Exqlite.query!(conn, ~S"drop table if exists users", []) end,
  fn -> Exqlite.query!(conn, ~S"drop table if exists commentRatings", []) end,
  fn -> IO.puts "Dropped Tables" end,
]

```

### Relational tables

Note:

* All string types should be of length at least 255 e.g. `varchar(255)`.
* DDL statements should be laxed i.e. do only if (not) exists

```elixir
createTablesList = [
  fn -> Exqlite.query!(
    conn,
    ~S"""
    create table if not exists users (
      user_id integer primary key,
      name varchar(255) not null,
      role integer not null
    )
    """,
    []
  ) end,
  fn -> Exqlite.query!(
    conn,
    ~S"""
    create table if not exists posts (
      post_id integer primary key,
      post_title varchar(255) not null,
      creator_id integer not null,
      post_text varchar(2048) not null,
      foreign key (creator_id) references users(user_id)
    )
    """,
    []
  ) end,
  fn -> Exqlite.query!(
    conn,
    ~S"""
    create table if not exists pullrequests (
      pr_id integer primary key,
      post_id integer not null,
      contributor_id integer not null,
      title varchar(255) not null,
      description varchar(1024) not null,
      status varchar(16) not null,
      tags varchar(255) not null,
      date_created_utc varchar(255) not null,
      foreign key (post_id) references posts(post_id),
      foreign key (contributor_id) references users(user_id)
    )
    """,
    []
  ) end,
  fn -> Exqlite.query!(
    conn,
    ~S"""
    create table if not exists comments (
      comment_id integer primary key,
      parent_post_id integer nullable,
      parent_comment_id integer nullable,
      content varchar(255) not null,
      commenter_id integer not null,
      date_created_utc varchar(255) not null,
      post_version integer not null,
      foreign key (commenter_id) references users(user_id),
      foreign key (parent_post_id) references posts(post_id),
      foreign key (parent_comment_id) references comments(comment_id)
    )
    """,
    []
  ) end,
  fn -> Exqlite.query!(
    conn,
    ~S"""
    create table if not exists commentratings (
      comment_rating_id integer primary key,
      commenter_id integer,
      comment_id integer,
      rating byte,
      foreign key (commenter_id) references users(user_id),
      foreign key (comment_id) references comments(comment_id)
    )
    """,
    []
  ) end,
  fn -> IO.puts "Created Tables" end,
]
IO.inspect createTablesList
```

```elixir
for drop <- dropTablesList do drop.() end
for create <- createTablesList do create.() end
```

### Scenario 1

```elixir
result2 = Exqlite.query!(conn, ~S"delete from comments", [])
result2 = Exqlite.query!(conn, ~S"delete from pullrequests", [])
result2 = Exqlite.query!(conn, ~S"delete from posts", [])
result2 = Exqlite.query!(conn, ~S"delete from users", [])
```

```elixir
result3 =
  Exqlite.query!(
    conn,
    ~S"""
    insert into users values (0, 'yminsky_fan')
    """,
    []
  )
result3 =
  Exqlite.query!(
    conn,
    ~S"""
    insert into posts values (77, 'Seven Implementations of Incremental', 0, 'Video from Jane Street Tech Talk\n\nIncremental là một thư viện FRP (functional reactive programming) dùng để viết hàm tính toán tích hợp đạo hàm ‌và giải tích tự động. Anh em nào đam mê Giải tích 1 2, và thích code React, và thích đại số trừu tượng, thì có thể tham khảo.\n\n# FRP là gì?\n\nTBA')
    """,
    []
  )
result3 =
  Exqlite.query!(
    conn,
    ~S"""
    insert into pullrequests values (6, 77, 0, 'Original post edits', 'Sau ngày 9/3/2016, admin bên Jane Street blog có chỉnh nội dung blog ngầm. Mấy này không ảnh hưởng đến integrity của post nhưng mình vẫn nên bump ref cho chính xác.', 'open', 'doc', '2026-04-28T15:18:26Z')
    """,
    []
  )
result3 =
  Exqlite.query!(
    conn,
    ~S"""
    insert into pullrequests values (7, 77, 0, 'Giới thiệu về FRP cho người học mới', 'Post có thể cải thiện thêm bằng cách thêm phần giới thiệu kiến thức. Này mình không có opinion, nhưng OP có thể tham khảo ở đây: https://blog.janestreet.com/breaking-down-frp/', 'closed', 'doc,frp', '2026-03-12T11:08:06Z')
    """,
    []
  )

result3 =
  Exqlite.query!(
    conn,
    ~S"""
    insert into pullrequests values (8, 77, 0, 'Giới thiệu về FRP cho người học mới', 'Post có thể cải thiện thêm bằng cách thêm phần giới thiệu kiến thức. Này mình không có opinion, nhưng OP có thể tham khảo ở đây: https://blog.janestreet.com/breaking-down-frp/', 'merged', '', '2026-03-12T11:08:06Z')
    """,
    []
  )
```

